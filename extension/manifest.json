{
  "manifest_version": 3,
  "name": "课题资料桥 · Classroom & Drive",
  "version": "0.7.0",
  "description": "本机脚本批量读取 Classroom 与 Drive，下载资料并打包；不需要 AI，聊天分析与自动化可选。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "alarms"
  ],
  "optional_host_permissions": [
    "http://127.0.0.1/*",
    "https://classroom.google.com/*",
    "https://drive.google.com/*",
    "https://docs.google.com/*",
    "https://drive.usercontent.google.com/*",
    "https://*.googleusercontent.com/*",
    "https://*.chatgpt.site/*",
    "https://*.chatgpt-team.site/*",
    "https://*.appgardenapps.dev/*",
    "https://*.appgardenapps.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "采集课题资料"
  },
  "key": "",
  "background": {
    "service_worker": "background.js"
  }
}
